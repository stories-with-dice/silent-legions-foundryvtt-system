{
  "id": "silent-legions",
  "title": "Silent Legions",
  "description": "Minimal unofficial system for Silent Legions, the Lovecraftian horror RPG by Kevin Crawford (Sine Nomine Publishing). Ships rules mechanics only; import spells, items, creatures, and tables from your own copy of the PDF.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13.351"
  },

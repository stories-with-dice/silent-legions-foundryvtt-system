<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="bio">
  <h3 class="sl-section">{{localize "SL.Biography"}}</h3>
  <prose-mirror name="system.biography" value="{{source.biography}}" toggled {{#unless editable}}disabled{{/unless}}>{{{enriched.biography}}}</prose-mirror>
  <h3 class="sl-section">{{localize "SL.Notes"}}</h3>
  <prose-mirror name="system.notes" value="{{source.notes}}" toggled {{#unless editable}}disabled{{/unless}}>{{{enriched.notes}}}</prose-mirror>
</section>

<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="skills">
  <div class="sl-skill-toolbar">
    <label>{{localize "SL.SkillPoints"}} <input type="number" name="system.skillPoints" value="{{source.skillPoints}}"></label>
    <span class="sl-hint">{{localize "SL.MaxSkill"}} {{system.maxSkillLevel}}</span>
    <div class="sl-filter" role="group">
      {{#each skillFilters}}
      <button type="button" class="{{#if active}}active{{/if}}" data-action="skillFilter" data-filter="{{key}}" aria-pressed="{{active}}">{{localize label}}</button>
      {{/each}}
    </div>
    {{#if editable}}
    <button type="button" data-action="bonusSkills" data-tooltip="{{localize 'SL.BonusSkillsHint'}}"><i class="fa-solid fa-list-check"></i> {{localize "SL.BonusSkills"}}</button>
    {{/if}}
  </div>

  <ol class="sl-skill-grid" data-filter="{{skillFilter}}">
    {{#each skills}}
    <li class="sl-skill {{#unless trained}}untrained{{/unless}} {{#if classSkill}}class-skill{{/if}}" data-item-id="{{id}}">
      <a class="sl-item-name" data-action="roll" data-roll-type="skill" data-tooltip="{{localize 'SL.ShiftSkip'}}">
        {{name}}{{#if classSkill}} <i class="fa-solid fa-star sl-class-skill" data-tooltip="{{localize 'SL.ClassSkill'}}"></i>{{/if}}
      </a>
      <span class="sl-hint">{{attribute}}</span>
      <input type="number" class="sl-small" data-item-field="system.level" value="{{level}}" min="-1" max="4"
        data-tooltip="{{localize 'SL.LevelUntrainedHint'}}">
      {{#if ../editable}}
      <a data-action="buySkill" data-tooltip="{{buyTooltip}}"><i class="fa-solid fa-circle-plus"></i></a>
      <a data-action="itemEdit" data-tooltip="{{localize 'SL.Edit'}}"><i class="fa-solid fa-pen"></i></a>
      <a data-action="itemDelete" data-tooltip="{{localize 'SL.Delete'}}"><i class="fa-solid fa-trash"></i></a>
      {{/if}}
    </li>
    {{else}}
    <li class="sl-empty">{{localize "SL.NoSkills"}}</li>
    {{/each}}
  </ol>

  {{#if editable}}
  <div class="sl-row">
    <select name="learn-skill">
      {{#each missingSkills}}<option value="{{this}}">{{this}}</option>{{/each}}
    </select>
    <button type="button" data-action="learnSkill"><i class="fa-solid fa-plus"></i> {{localize "SL.AddSkill"}}</button>
  </div>
  {{/if}}
  <p class="sl-hint">{{localize "SL.UntrainedHint"}}</p>
</section>
